  "sounds": [
    {
      "id": "fiddle",
      "tune": "reel",
      "role": "lead",
      "note": "Bowed, bright, with a little rosin on the start of each note. For Harlow Bridge."
    },
    {
      "id": "oldfiddle",
      "tune": "air",
      "role": "lead",
      "note": "Darker and more nasal, the strings a shade apart, more scratch. The Bard's old fiddle."
    },
    {
      "id": "woodflute",
      "tune": "air",
      "role": "lead",
      "note": "Breathy and round. Open hills and dry-stone walls."
    },
    {
      "id": "whistle",
      "tune": "reel",
      "role": "lead",
      "note": "A tin whistle, an octave up, quick on the attack."
    },
    {
      "id": "melodeon",
      "tune": "reel",
      "role": "both",
      "note": "Two reeds a little apart, so it shimmers. Plays the tune and the off-beat chords."
    },
    {
      "id": "pumporgan",
      "tune": "air",
      "role": "both",
      "note": "Soft reeds with a wheeze of air: a chapel or a parlour. Tune and held chords."
    },
    {
      "id": "dulcimer",
      "tune": "reel",
      "role": "lead",
      "note": "Struck strings in pairs, ringing on."
    },
    {
      "id": "cittern",
      "tune": "air",
      "role": "backing",
      "note": "Paired plucked strings, strummed under the soft flute."
    },
    {
      "id": "drone",
      "tune": "air",
      "role": "drone",
      "note": "Low A and E held under the soft flute. Quiet, for the quarry and the emptying farms."
    }
  ]
